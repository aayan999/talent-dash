generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Salary {
  id                 String   @id @default(uuid())
  company            String   // Must be normalized (lowercase, trimmed) before saving
  role               String
  level              String   // STANDARDIZED: L3/L4/L5 etc.
  location           String
  experience_years   Float
  base_salary        Int
  bonus              Int      @default(0) // Default 0 if missing per requirements
  stock              Int      @default(0) // Default 0 if missing per requirements
  total_compensation Int      // Calculated: base + bonus + stock
  confidence_score   Float    // Dummy AI score for now
  created_at         DateTime @default(now())

  // Indexes for fast server-side filtering (Crucial for GET /salaries)
  @@index([company])
  @@index([role])
  @@index([level])
  @@index([location])
}